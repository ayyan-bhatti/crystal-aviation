# ============================================================================
# PUBLIC values — safe to expose. They are embedded into the website at build time.
# Put these in `.env` for local builds and in Cloudflare → Workers → Settings →
# Build → Variables for deployed builds.
# ============================================================================

# Supabase → Project Settings → Data API → Project URL
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...).
# Safe in the browser because Row Level Security protects the data.
PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx

# Primary WhatsApp enquiry destination, digits only, international format.
# PROVISIONAL: Umar Farooq's number. Confirm with the owner before launch.
PUBLIC_WHATSAPP_NUMBER=923217643345

# Canonical site URL (no trailing slash).
PUBLIC_SITE_URL=https://thecrystalaviation.com

# Only for a clearly-labelled demo preview. Never set to true for the live site.
PUBLIC_DEMO_MODE=false

# ============================================================================
# SECRET values — NEVER commit, NEVER put in Cloudflare or any PUBLIC_ variable.
# Put these only in `.env.local` on the trusted computer used for admin tasks
# (staff provisioning, backups, database migrations).
# ============================================================================

# Supabase → Project Settings → API Keys → Secret key (sb_secret_...). Bypasses RLS.
SUPABASE_SECRET_KEY=
# Supabase → Connect → Session pooler connection string (contains the DB password).
SUPABASE_DB_URL=
