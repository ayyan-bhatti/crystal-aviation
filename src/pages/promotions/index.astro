---
export const prerender = false;

import { categoryPhotos } from '../../lib/category-photos';
import BaseLayout from '../../layouts/BaseLayout.astro';
import Intro from '../../components/Intro.astro';
import LiveOffers from '../../components/offers/LiveOffers';
import Icon from '../../components/Icon';
import greenDome from '../../assets/photos/madinah-green-dome.jpg';
import bangkok from '../../assets/photos/bangkok-wat-arun.jpg';
import plane from '../../assets/photos/plane-blue-sky.jpg';
import pool from '../../assets/photos/resort-pool.jpg';
import { site } from '../../config/site';
import { fetchActivePromotions, MAX_PAGE_SIZE } from '../../lib/promotions-api';
import { CATEGORIES, CATEGORY_LABELS, type Category } from '../../lib/types';
import { serviceEnquiryMessage, whatsappLink } from '../../lib/whatsapp';

// Fresh on every request: no shared cache can keep an expired offer visible.
Astro.response.headers.set('Cache-Control', 'no-store');

const param = Astro.url.searchParams.get('category');
const selected = (CATEGORIES as readonly string[]).includes(param ?? '') ? (param as Category) : null;

const all = await fetchActivePromotions({ limit: MAX_PAGE_SIZE });
const present = all.status === 'ok' ? CATEGORIES.filter((c) => all.data.some((p) => p.category === c)) : [];
const initial =
  all.status === 'ok' && selected ? { ...all, data: all.data.filter((p) => p.category === selected) } : all;
if (all.status === 'error') Astro.response.status = 503;

const msg = serviceEnquiryMessage('your current offers', site.url + '/promotions');
const photos = await categoryPhotos();
---

<BaseLayout
  title={selected ? `${CATEGORY_LABELS[selected]} offers` : 'Current offers'}
  path={selected ? `/promotions?category=${selected}` : '/promotions'}
  description="Current Umrah, tour, airline-ticket, hotel and visa-assistance promotions from The Crystal Aviation, Faisalabad. Ask about any offer on WhatsApp."
  whatsappMessage={msg}
>
  <Intro
    label="Offers"
    title="Current offers"
    lead="Umrah, tour, airline-ticket and hotel promotions published by our team. Prices and availability are always confirmed with you before anything is booked."
    photos={[
      { src: greenDome, alt: "The green dome of Masjid an-Nabawi, Madinah", label: "Umrah offers", href: "/promotions?category=umrah", position: "50% 35%" },
      { src: bangkok, alt: "Wat Arun temple in Bangkok at sunset", label: "Tour offers", href: "/promotions?category=tour" },
      { src: plane, alt: "A passenger jet in a clear blue sky", label: "Airline tickets", href: "/promotions?category=flight" },
      { src: pool, alt: "Resort swimming pool with sun loungers", label: "Hotel offers", href: "/promotions?category=hotel" },
    ]}
  >
    <a class="btn btn--whatsapp" href={whatsappLink(msg)} target="_blank" rel="noopener"><Icon name="whatsapp" /> Ask about offers</a>
  </Intro>

  <section class="section" aria-labelledby="offers-list">
    <div class="container">
      <h2 id="offers-list" class="visually-hidden">Offers</h2>
      {
        present.length > 1 ? (
          <nav class="filters" aria-label="Filter offers by type">
            <a href="/promotions" aria-current={selected ? undefined : 'true'}>All</a>
            {present.map((c) => (
              <a href={`/promotions?category=${c}`} aria-current={selected === c ? 'true' : undefined}>
                {CATEGORY_LABELS[c]}
              </a>
            ))}
          </nav>
        ) : null
      }
      <LiveOffers
        fallbacks={photos}
        client:load
        initial={initial}
        category={selected ?? undefined}
        limit={MAX_PAGE_SIZE}
        headingLevel={3}
        emptyText={selected ? `There are no ${CATEGORY_LABELS[selected].toLowerCase()} offers published right now.` : 'There are no offers published on the website right now.'}
        whatsappMessage={msg}
      />
    </div>
  </section>
</BaseLayout>
