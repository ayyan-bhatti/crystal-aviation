---
import { categoryPhotos } from '../lib/category-photos';
import BaseLayout from '../layouts/BaseLayout.astro';
import Intro from '../components/Intro.astro';
import VisaRegions from '../components/VisaRegions.astro';
import london from '../assets/photos/london-big-ben.jpg';
import LiveOffers from '../components/offers/LiveOffers';
import EnquiryComposer from '../components/EnquiryComposer';
import Icon from '../components/Icon';
import { site } from '../config/site';
import { serviceEnquiryMessage, whatsappLink } from '../lib/whatsapp';

const msg = serviceEnquiryMessage('visa application assistance', site.url + '/visa');
const photos = await categoryPhotos();
---

<BaseLayout
  title="Visa assistance"
  path="/visa"
  description="Help preparing visa application files for the UK, USA and Europe from The Crystal Aviation, Faisalabad. Discuss your circumstances privately with our team."
  whatsappMessage={msg}
>
  <Intro
    label="Visa assistance"
    title="Application files, prepared properly."
    lead="Consultation and application-file support for visits to the United Kingdom, the United States and Europe."
    image={london}
    imageAlt="Big Ben and the Houses of Parliament in London with a red bus passing"
    caption="Westminster, London"
    position="50% 12%"
  >
    <a class="btn btn--whatsapp" href={whatsappLink(msg)} target="_blank" rel="noopener"><Icon name="whatsapp" /> Discuss your application</a>
  </Intro>

  <section class="section section--sand" aria-labelledby="visa-what">
    <div class="container split" style="align-items: center">
      <div>
        <h2 id="visa-what">What we help with</h2>
        <ul class="checklist">
          <li>A private conversation about your travel purpose and plans</li>
          <li>Understanding what the application usually asks for</li>
          <li>Organising and preparing your application file</li>
        </ul>
      </div>
      <VisaRegions />
    </div>
  </section>

  <section class="section" aria-labelledby="visa-important">
    <div class="container split">
      <h2 id="visa-important">Please note</h2>
      <div>
        <p class="lead">Visa decisions are made only by the relevant embassy, consulate or immigration authority. No agent can guarantee an approval or a processing time.</p>
        <p>Requirements change and depend on your personal circumstances, so please discuss your case with our team directly rather than relying on general information.</p>
        <p><strong>Please don’t send passports, bank statements or other personal documents through this website.</strong> Our team will tell you how to share documents safely if needed.</p>
      </div>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="visa-offers">
    <div class="container">
      <div class="section-head"><h2 id="visa-offers">Visa assistance offers</h2></div>
      <LiveOffers fallbacks={photos} client:visible category="visa" limit={6} emptyText="There are no visa-assistance offers published on the website at the moment." whatsappMessage={msg} />
    </div>
  </section>

  <section class="section section--sand" aria-labelledby="visa-enquiry">
    <div class="container split">
      <div>
        <h2 id="visa-enquiry">Start a conversation</h2>
        <p class="lead">Share only general details here. We’ll discuss your circumstances privately.</p>
      </div>
      <EnquiryComposer
        client:visible
        services={['Visa assistance: United Kingdom', 'Visa assistance: United States', 'Visa assistance: Europe']}
        destinationLabel="Country you plan to visit"
        destinationPlaceholder="e.g. United Kingdom"
        callTel={site.landline.tel}
        callDisplay={site.landline.display}
        email={site.email}
      />
    </div>
  </section>
</BaseLayout>
