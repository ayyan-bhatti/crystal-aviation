---
import BaseLayout from '../layouts/BaseLayout.astro';
import Intro from '../components/Intro.astro';
import CardContact from '../components/CardContact.astro';
import ExploreCards from '../components/ExploreCards.astro';
import Icon from '../components/Icon';
import kaabaCourtyard from '../assets/photos/makkah-kaaba-courtyard.jpg';
import madinahMosque from '../assets/photos/madinah-mosque.jpg';
import baku from '../assets/photos/baku-old-city.jpg';
import langkawi from '../assets/photos/langkawi-bay.jpg';
import { site } from '../config/site';
import { serviceEnquiryMessage, whatsappLink } from '../lib/whatsapp';

const msg = serviceEnquiryMessage('your travel services', site.url + '/about');
---

<BaseLayout
  title="About us"
  path="/about"
  description="The Crystal Aviation is a travel agency in Faisalabad led by Umar Farooq, CEO, and Zeeshan Saleem, MD. We arrange Umrah, holidays abroad and visa application files."
  whatsappMessage={msg}
>
  <Intro
    label="About us"
    title="The Crystal Aviation"
    lead="A travel agency in Faisalabad, built on personal service. When you contact us, you speak with our team directly."
    photos={[
      { src: kaabaCourtyard, alt: 'Pilgrims around the Kaaba in Masjid al-Haram, Makkah', label: 'Makkah', href: '/umrah' },
      { src: madinahMosque, alt: 'The Green Dome of Masjid an-Nabawi, Madinah', label: 'Madinah', href: '/umrah', position: '30% 50%' },
      { src: baku, alt: 'Old city street in Baku with the Flame Towers', label: 'Baku', href: '/tours#baku', position: '50% 60%' },
      { src: langkawi, alt: 'Islands and bay of Langkawi, Malaysia', label: 'Malaysia', href: '/tours#malaysia' },
    ]}
  >
    <a class="btn btn--whatsapp" href={whatsappLink(msg)} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp us</a>
    <a class="btn btn--ghost" href="/contact">Visit us</a>
  </Intro>

  <section class="section section--sand" aria-labelledby="who-title">
    <div class="container split">
      <h2 id="who-title">Who we are</h2>
      <div>
        <p class="lead">
          {site.name} is a travel agency based in Rafih Plaza on Main Gulberg Road, Faisalabad. The agency is led by
          {' '}{site.team[0].name}, our CEO, and {site.team[1].name}, our Managing Director.
        </p>
        <p>
          We help families and travellers plan Umrah, holidays abroad and visa application files. We also share special
          offers on airline tickets and hotels whenever they are available.
        </p>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="how-title">
    <div class="container split">
      <h2 id="how-title">How we work</h2>
      <div>
        <p class="lead">
          We believe travel should be arranged by people you can actually reach. You can message or call Umar and Zeeshan
          directly, visit our office, and ask us anything along the way.
        </p>
        <p>
          Every enquiry starts with a conversation about your dates, your family and what matters to you. Prices and
          availability are always confirmed with you before anything is booked.
        </p>
        <p class="muted small">We are a travel agency, not an airline. Nothing is booked through this website until our team confirms it with you.</p>
      </div>
    </div>
  </section>

  <ExploreCards heading="Where can we take you?" intro="Tap a destination to see more, or message us about it on WhatsApp." />

  <section class="section" aria-labelledby="about-contact">
    <div class="container split" style="align-items: center">
      <div>
        <h2 id="about-contact">Visit or call us</h2>
        <p class="lead">Talk to {site.team[0].name} or {site.team[1].name} directly, or come and see us at the office.</p>
      </div>
      <CardContact />
    </div>
  </section>
</BaseLayout>
