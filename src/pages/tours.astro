---
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import LiveOffers from '../components/offers/LiveOffers';
import EnquiryComposer from '../components/EnquiryComposer';
import Icon from '../components/Icon';
import baku from '../assets/photos/baku-flame-towers.jpg';
import thailand from '../assets/photos/thailand-phi-phi.jpg';
import singapore from '../assets/photos/singapore-marina-bay.jpg';
import malaysia from '../assets/photos/malaysia-petronas.jpg';
import { site } from '../config/site';
import { serviceEnquiryMessage, whatsappLink } from '../lib/whatsapp';

const pageUrl = site.url + '/tours';
const msg = serviceEnquiryMessage('an international tour', pageUrl);

// Destinations mentioned by the client. These are enquiry prompts, not packages.
const destinations = [
  { name: 'Baku', country: 'Azerbaijan', image: baku, alt: 'Baku’s Flame Towers above the city and bay', note: 'Modern skyline and old city by the Caspian Sea.' },
  { name: 'Thailand', country: '', image: thailand, alt: 'Longtail boat on turquoise water near limestone cliffs in Koh Phi Phi, Thailand', note: 'Islands, beaches and busy city life.' },
  { name: 'Singapore', country: '', image: singapore, alt: 'Marina Bay Sands and the bay in Singapore on a clear day', note: 'A compact, easy-to-explore city break.' },
  { name: 'Malaysia', country: '', image: malaysia, alt: 'The Petronas Twin Towers in Kuala Lumpur, seen from a pool below', note: 'Kuala Lumpur and beyond.' },
];
---

<BaseLayout
  title="International tours"
  path="/tours"
  description="International tours arranged by The Crystal Aviation, Faisalabad, to destinations such as Baku, Thailand, Singapore and Malaysia. Ask on WhatsApp."
  whatsappMessage={msg}
>
  <PageHero
    eyebrow="International tours"
    title="Holidays abroad, arranged around you"
    lead="Tell us where you’d like to go, when, and who’s coming. We’ll talk through what’s available for your dates."
    image={singapore}
    position="50% 35%"
  >
    <a class="btn btn--whatsapp" href={whatsappLink(msg)} target="_blank" rel="noopener"><Icon name="whatsapp" /> Ask about a tour</a>
  </PageHero>

  <section class="section" aria-labelledby="dest-title">
    <div class="container">
      <p class="eyebrow">Popular with our travellers</p>
      <h2 id="dest-title">Where would you like to go?</h2>
      <p class="lead" style="margin-bottom: var(--space-xl)">
        A few of the destinations we’re often asked about. Packages, dates and prices vary, so ask us what’s currently available.
      </p>
      <div class="destinations">
        {
          destinations.map((d) => (
            <article class="destination">
              <Image src={d.image} alt={d.alt} widths={[400, 700, 1000]} sizes="(min-width: 1100px) 25vw, (min-width: 600px) 50vw, 100vw" />
              <div class="destination__body">
                <h3>{d.name}</h3>
                <p>{d.note}</p>
                <a class="btn btn--whatsapp btn--small" href={whatsappLink(serviceEnquiryMessage(`a tour to ${d.name}`, pageUrl))} target="_blank" rel="noopener">
                  <Icon name="whatsapp" /> Ask about {d.name}
                </a>
              </div>
            </article>
          ))
        }
      </div>
      <p class="small muted" style="margin-top: var(--space-m)">Planning somewhere else? Just ask.</p>
    </div>
  </section>

  <section class="section section--paper" aria-labelledby="tour-offers">
    <div class="container">
      <p class="eyebrow">Current offers</p>
      <h2 id="tour-offers" style="margin-bottom: var(--space-xl)">Tour, ticket and hotel promotions</h2>
      <LiveOffers
        client:load
        category={['tour', 'flight', 'hotel']}
        limit={12}
        emptyText="There are no tour, ticket or hotel offers published on the website at the moment."
        whatsappMessage={msg}
      />
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="tour-enquiry">
    <div class="container narrow">
      <p class="eyebrow">Enquire</p>
      <h2 id="tour-enquiry">Plan your trip</h2>
      <p class="lead" style="margin-bottom: var(--space-l)">Fill in what you know. We’ll turn it into a WhatsApp message for you to send.</p>
      <EnquiryComposer
        client:visible
        services={['International tour', 'Airline tickets', 'Hotel booking']}
        callTel={site.landline.tel}
        callDisplay={site.landline.display}
        email={site.email}
      />
    </div>
  </section>
</BaseLayout>
