---
import { categoryPhotos } from '../lib/category-photos';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import Intro from '../components/Intro.astro';
import LiveOffers from '../components/offers/LiveOffers';
import EnquiryComposer from '../components/EnquiryComposer';
import Icon from '../components/Icon';
import plane from '../assets/photos/plane-blue-sky.jpg';
import baku from '../assets/photos/baku-old-city.jpg';
import bangkok from '../assets/photos/bangkok-wat-arun.jpg';
import singapore from '../assets/photos/singapore-supertrees.jpg';
import langkawi from '../assets/photos/langkawi-bay.jpg';
import { site } from '../config/site';
import { serviceEnquiryMessage, whatsappLink } from '../lib/whatsapp';

const pageUrl = site.url + '/tours';
const msg = serviceEnquiryMessage('an international tour', pageUrl);
const ask = (d: string) => whatsappLink(serviceEnquiryMessage(`a tour to ${d}`, pageUrl));

// Destinations mentioned by the client. These are enquiry prompts, not packages.
const destinations = [
  { name: 'Baku', note: 'Old city lanes, the Flame Towers and the Caspian waterfront.', image: baku, alt: 'Old-city street in Baku with carved balconies, the Flame Towers rising behind', pos: '50% 60%' },
  { name: 'Thailand', note: 'Bangkok’s temples and markets, then the islands and beaches.', image: bangkok, alt: 'Wat Arun temple in Bangkok glowing at sunset across the Chao Phraya river', pos: '50% 50%' },
  { name: 'Singapore', note: 'A compact, green and easy city for families.', image: singapore, alt: 'The Supertree Grove and skyway at Gardens by the Bay, Singapore', pos: '50% 30%' },
  { name: 'Malaysia', note: 'Kuala Lumpur, and island time in Langkawi.', image: langkawi, alt: 'View over the islands and bay of Langkawi, Malaysia, from the hills', pos: '50% 50%' },
];
const photos = await categoryPhotos();
---

<BaseLayout
  title="International tours"
  path="/tours"
  description="Holidays abroad arranged by The Crystal Aviation, Faisalabad, to places like Baku, Thailand, Singapore and Malaysia. Ask us on WhatsApp."
  whatsappMessage={msg}
>
  <Intro
    label="International tours"
    title="Holidays abroad, arranged around you."
    lead="Tell us where you’d like to go, when, and who’s coming. We’ll talk through what’s available for your dates, including airline tickets and hotels."
    photos={[{ src: plane, alt: "A passenger jet flying overhead in a clear blue sky" }]}
  >
    <a class="btn btn--whatsapp" href={whatsappLink(msg)} target="_blank" rel="noopener"><Icon name="whatsapp" /> Ask about a tour</a>
  </Intro>

  <section class="section" aria-label="Destinations">
    <div class="container">
      <div class="mosaic">
        {
          destinations.map((d, i) => (
            <a id={d.name.toLowerCase()} class:list={['tile', { 'tile--tall': i === 0 }]} href={ask(d.name)} target="_blank" rel="noopener">
              <Image src={d.image} alt={d.alt} widths={[500, 800, 1200]} sizes="(min-width: 1000px) 35vw, 100vw" style={`object-position: ${d.pos}`} />
              <div class="tile__body">
                <h2 class="tile__name">{d.name}</h2>
                <p class="tile__note">{d.note}</p>
                <span class="tile__cta">Ask about {d.name}</span>
              </div>
            </a>
          ))
        }
        <div class="tile tile--text">
          <div class="tile__body">
            <p class="tile__name">Somewhere else?</p>
            <p class="tile__note">Tell us where and when, and we’ll look into it.</p>
          </div>
        </div>
      </div>
      <p class="small muted" style="margin-top: var(--space-m)">Packages, dates and prices vary, so ask us what’s currently available.</p>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="tour-offers">
    <div class="container">
      <div class="section-head">
        <h2 id="tour-offers">Tour, ticket and hotel offers</h2>
        <p>Current promotions from our team.</p>
      </div>
      <LiveOffers fallbacks={photos} client:load category={['tour', 'flight', 'hotel']} limit={12} emptyText="There are no tour, ticket or hotel offers published on the website at the moment." whatsappMessage={msg} />
    </div>
  </section>

  <section class="section section--sand" aria-labelledby="tour-enquiry">
    <div class="container split">
      <div>
        <h2 id="tour-enquiry">Plan your trip</h2>
        <p class="lead">Fill in what you know. We’ll turn it into a WhatsApp message for you to send.</p>
      </div>
      <EnquiryComposer client:visible services={['International tour', 'Airline tickets', 'Hotel booking']} callTel={site.landline.tel} callDisplay={site.landline.display} email={site.email} />
    </div>
  </section>
</BaseLayout>
