---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import LiveOffers from '../components/offers/LiveOffers';
import EnquiryComposer from '../components/EnquiryComposer';
import Icon from '../components/Icon';
import umrah from '../assets/photos/umrah-kaaba-courtyard.jpg';
import { site } from '../config/site';
import { serviceEnquiryMessage, whatsappLink } from '../lib/whatsapp';

const msg = serviceEnquiryMessage('Umrah', site.url + '/umrah');
---

<BaseLayout
  title="Umrah"
  path="/umrah"
  description="Plan your Umrah with The Crystal Aviation in Faisalabad. Talk to our team about dates, travellers and preferences, and see current Umrah offers."
  whatsappMessage={msg}
>
  <PageHero
    eyebrow="Umrah"
    title="Umrah, planned around you"
    lead="Speak directly with our team about your Umrah: when you’d like to travel, who is travelling with you, and what matters most for your journey."
    image={umrah}
    position="50% 45%"
  >
    <a class="btn btn--whatsapp" href={whatsappLink(msg)} target="_blank" rel="noopener"><Icon name="whatsapp" /> Ask about Umrah</a>
  </PageHero>

  <section class="section section--paper" aria-labelledby="umrah-offers">
    <div class="container">
      <p class="eyebrow">Current Umrah offers</p>
      <h2 id="umrah-offers" style="margin-bottom: var(--space-xl)">Umrah promotions</h2>
      <LiveOffers
        client:load
        category="umrah"
        limit={12}
        emptyText="There are no Umrah offers published on the website at the moment."
        whatsappMessage={msg}
      />
    </div>
  </section>

  <section class="section" aria-labelledby="umrah-plan">
    <div class="container split">
      <div>
        <p class="eyebrow">Before you message us</p>
        <h2 id="umrah-plan">Helpful things to share</h2>
        <p class="lead">You don’t need everything decided. These details help us give you relevant options more quickly.</p>
      </div>
      <ul class="checklist">
        <li>Your preferred month or travel dates, and how flexible they are</li>
        <li>How many people are travelling, including children and elderly travellers</li>
        <li>The city you’d like to travel from</li>
        <li>Any preferences for your stay, such as distance to the Haram</li>
        <li>An approximate budget, if you have one in mind</li>
      </ul>
    </div>
  </section>

  <section class="section section--tint" aria-labelledby="umrah-enquiry">
    <div class="container narrow">
      <p class="eyebrow">Enquire</p>
      <h2 id="umrah-enquiry">Start your Umrah enquiry</h2>
      <p class="lead" style="margin-bottom: var(--space-l)">Fill in what you know. We’ll turn it into a WhatsApp message for you to send.</p>
      <EnquiryComposer
        client:visible
        services={['Umrah']}
        defaultService="Umrah"
        destinationLabel="Travelling from"
        destinationPlaceholder="e.g. Faisalabad, Lahore"
        callTel={site.landline.tel}
        callDisplay={site.landline.display}
        email={site.email}
      />
    </div>
  </section>
</BaseLayout>
