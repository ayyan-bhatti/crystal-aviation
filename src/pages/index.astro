---
import { categoryPhotos } from '../lib/category-photos';
import { Image } from 'astro:assets';
import BaseLayout from '../layouts/BaseLayout.astro';
import LiveOffers from '../components/offers/LiveOffers';
import CardContact from '../components/CardContact.astro';
import VisaRegions from '../components/VisaRegions.astro';
import Icon from '../components/Icon';
import madinah from '../assets/photos/madinah-golden-hour.jpg';
import greenDome from '../assets/photos/madinah-green-dome.jpg';
import makkah from '../assets/photos/makkah-haram-night.jpg';
import baku from '../assets/photos/baku-old-city.jpg';
import bangkok from '../assets/photos/bangkok-wat-arun.jpg';
import singapore from '../assets/photos/singapore-supertrees.jpg';
import langkawi from '../assets/photos/langkawi-bay.jpg';
import { site } from '../config/site';
import { travelAgencyJsonLd } from '../lib/seo';
import { serviceEnquiryMessage, whatsappLink } from '../lib/whatsapp';

const home = site.url + '/';
const wa = whatsappLink(serviceEnquiryMessage('your travel services', home));
const waUmrah = whatsappLink(serviceEnquiryMessage('Umrah', home));
const tourLink = (d: string) => whatsappLink(serviceEnquiryMessage(`a tour to ${d}`, home));
const photos = await categoryPhotos();
---

<BaseLayout
  title="Home"
  path="/"
  description="The Crystal Aviation, Faisalabad: Umrah, holidays abroad to places like Baku, Thailand, Singapore and Malaysia, and visa application files for the UK, USA and Europe. Talk to us on WhatsApp."
  jsonLd={travelAgencyJsonLd()}
>
  <section class="hero" aria-labelledby="hero-title">
    <div class="container hero__grid">
      <div>
        <h1 id="hero-title">Travel arranged by people you can call.</h1>
        <p class="lead">
          Umrah, holidays abroad and visa application files, arranged from our office on Main Gulberg Road, Faisalabad.
        </p>
        <div class="btn-row">
          <a class="btn btn--whatsapp" href={wa} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp us</a>
          <a class="btn btn--ghost" href="/promotions">Current offers</a>
        </div>
        <div class="hero__contacts">
          {site.team.map((m) => <span>{m.name}, {m.role} · <a href={`tel:${m.tel}`}>{m.display}</a></span>)}
        </div>
      </div>
      <figure class="hero__media">
        <div class="hero__main">
          <Image src={madinah} alt="Worshippers crossing the courtyard of Masjid an-Nabawi in Madinah at sunset, under its great umbrellas" widths={[640, 900, 1300, 1800]} sizes="(min-width: 900px) 45vw, 100vw" loading="eager" fetchpriority="high" style="object-position: 38% 50%" />
        </div>
        <div class="hero__inset" aria-hidden="true">
          <Image src={bangkok} alt="" widths={[300, 500]} sizes="18vw" loading="eager" />
        </div>
        <figcaption class="caption">Masjid an-Nabawi, Madinah</figcaption>
      </figure>
    </div>
  </section>

  <section class="section section--white" aria-labelledby="offers-title">
    <div class="container">
      <div class="section-head">
        <h2 id="offers-title">Current offers</h2>
        <p>Published by our team. Prices and availability are confirmed with you on WhatsApp before anything is booked.</p>
      </div>
      <LiveOffers
        fallbacks={photos}
        client:load
        featuredOnly
        limit={6}
        moreHref="/promotions"
        emptyText="There are no featured offers on the website right now."
        whatsappMessage={serviceEnquiryMessage('your current offers', home)}
      />
    </div>
  </section>

  <section class="section section--lapis" aria-labelledby="umrah-title">
    <div class="container chapter">
      <div>
        <p class="label">Umrah</p>
        <h2 id="umrah-title">Umrah, arranged around your family.</h2>
        <p class="lead">Tell us when you’d like to go and who is travelling. We’ll talk you through the options, and you can ask us anything along the way.</p>
        <ul class="line-list">
          <li>Your preferred month and how flexible the dates are</li>
          <li>Who is travelling, including children and elderly parents</li>
          <li>Where you’d like to stay, and how close to the Haram</li>
        </ul>
        <div class="btn-row">
          <a class="btn btn--gold" href={waUmrah} target="_blank" rel="noopener"><Icon name="whatsapp" /> Ask about Umrah</a>
          <a class="text-link" href="/umrah">More about Umrah</a>
        </div>
      </div>
      <div class="chapter__photos">
        <figure>
          <div class="ph"><Image src={makkah} alt="Masjid al-Haram in Makkah at night, lit up and filled with worshippers" widths={[400, 700, 1000]} sizes="(min-width: 900px) 30vw, 55vw" /></div>
          <figcaption class="caption">Masjid al-Haram, Makkah</figcaption>
        </figure>
        <figure>
          <div class="ph"><Image src={greenDome} alt="The green dome and minarets of Masjid an-Nabawi against a blue sky" widths={[300, 600, 800]} sizes="(min-width: 900px) 24vw, 45vw" /></div>
          <figcaption class="caption">The Green Dome, Madinah</figcaption>
        </figure>
      </div>
    </div>
  </section>

  <section class="section" aria-labelledby="tours-title">
    <div class="container">
      <div class="section-head">
        <h2 id="tours-title">Holidays abroad</h2>
        <p>A few of the places our travellers ask about most. Dates, hotels and prices change, so ask us what’s available for your trip.</p>
      </div>
      <div class="mosaic">
        <a class="tile tile--tall" href={tourLink('Baku')} target="_blank" rel="noopener">
          <Image src={baku} alt="Old-city street in Baku with carved balconies, the Flame Towers rising behind" widths={[500, 800, 1200]} sizes="(min-width: 1000px) 38vw, 100vw" />
          <div class="tile__body"><p class="tile__name">Baku</p><p class="tile__note">Old city lanes and the Caspian waterfront</p><span class="tile__cta">Ask about Baku</span></div>
        </a>
        <a class="tile" href={tourLink('Thailand')} target="_blank" rel="noopener">
          <Image src={bangkok} alt="Wat Arun temple in Bangkok glowing at sunset across the Chao Phraya river" widths={[400, 700, 1000]} sizes="(min-width: 1000px) 30vw, 100vw" />
          <div class="tile__body"><p class="tile__name">Thailand</p><p class="tile__note">Bangkok, islands and beaches</p><span class="tile__cta">Ask about Thailand</span></div>
        </a>
        <a class="tile" href={tourLink('Singapore')} target="_blank" rel="noopener">
          <Image src={singapore} alt="The Supertree Grove and skyway at Gardens by the Bay, Singapore" widths={[400, 700, 1000]} sizes="(min-width: 1000px) 30vw, 100vw" style="object-position: 50% 35%" />
          <div class="tile__body"><p class="tile__name">Singapore</p><p class="tile__note">An easy, green city break</p><span class="tile__cta">Ask about Singapore</span></div>
        </a>
        <a class="tile" href={tourLink('Malaysia')} target="_blank" rel="noopener">
          <Image src={langkawi} alt="View over the islands and bay of Langkawi, Malaysia, from the hills" widths={[400, 700, 1000]} sizes="(min-width: 1000px) 30vw, 100vw" />
          <div class="tile__body"><p class="tile__name">Malaysia</p><p class="tile__note">Kuala Lumpur and Langkawi</p><span class="tile__cta">Ask about Malaysia</span></div>
        </a>
        <div class="tile tile--text">
          <div class="tile__body">
            <p class="tile__name">Somewhere else?</p>
            <p class="tile__note">Tell us where and when, and we’ll look into it.</p>
            <a class="text-link" href="/tours" style="margin-top: 0.8rem">All tour information</a>
          </div>
        </div>
      </div>
    </div>
  </section>

  <section class="section section--sand" aria-labelledby="visa-title">
    <div class="container split" style="align-items: center">
      <div>
        <p class="label">Visa assistance</p>
        <h2 id="visa-title">Application files, prepared properly.</h2>
        <p class="lead">We help you prepare and organise your visa application file, after a private conversation about your plans.</p>
        <p class="muted small">Decisions are made only by the embassy or consulate, and no agent can guarantee an outcome.</p>
        <a class="text-link" href="/visa">Visa assistance</a>
      </div>
      <VisaRegions />
    </div>
  </section>

  <section class="section" aria-labelledby="contact-title">
    <div class="container split" style="align-items: center">
      <div>
        <h2 id="contact-title">Talk to us directly</h2>
        <p class="lead">Message or call {site.team[0].name} or {site.team[1].name}, or visit the office in Rafih Plaza.</p>
        <p class="muted small">Nothing is booked through this website. Your booking is confirmed only when the agency confirms it with you.</p>
      </div>
      <CardContact />
    </div>
  </section>
</BaseLayout>
