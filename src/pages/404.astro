---
import BaseLayout from '../layouts/BaseLayout.astro';
import Intro from '../components/Intro.astro';
import Icon from '../components/Icon';
import langkawi from '../assets/photos/langkawi-bay.jpg';
import { serviceEnquiryMessage, whatsappLink } from '../lib/whatsapp';
---

<BaseLayout title="Page not found" path="/404" description="This page could not be found." noindex>
  <Intro
    label="Page not found"
    title="We couldn’t find that page."
    lead="The link may be old, or the page may have moved. Try the homepage, or message us and we’ll help."
    photos={[{ src: langkawi, alt: "View over the islands and bay of Langkawi, Malaysia" }]}
  >
    <a class="btn" href="/">Go to the homepage</a>
    <a class="btn btn--whatsapp" href={whatsappLink(serviceEnquiryMessage('your travel services'))} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp us</a>
  </Intro>
</BaseLayout>
