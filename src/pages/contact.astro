---
import BaseLayout from '../layouts/BaseLayout.astro';
import Intro from '../components/Intro.astro';
import CardContact from '../components/CardContact.astro';
import ExploreCards from '../components/ExploreCards.astro';
import EnquiryComposer from '../components/EnquiryComposer';
import Icon from '../components/Icon';
import travellers from '../assets/photos/airport-travellers.jpg';
import { site } from '../config/site';
import { travelAgencyJsonLd } from '../lib/seo';
import { serviceEnquiryMessage, whatsappLink } from '../lib/whatsapp';

const msg = serviceEnquiryMessage('your travel services', site.url + '/contact');
---

<BaseLayout
  title="Contact"
  path="/contact"
  description="Contact The Crystal Aviation, Faisalabad: WhatsApp or call Umar Farooq or Zeeshan Saleem, call 041 547 47 99, email thecrystalaviation@gmail.com, or visit Rafih Plaza, Main Gulberg Road."
  jsonLd={travelAgencyJsonLd()}
  whatsappMessage={msg}
>
  <Intro label="Contact" title="Talk to us directly." lead="WhatsApp or call our team, send an email, or visit the office on Main Gulberg Road, Faisalabad." photos={[{ src: travellers, alt: "Two travellers with backpacks looking at departure boards", position: "50% 40%" }]}>
    <a class="btn btn--whatsapp" href={whatsappLink(msg)} target="_blank" rel="noopener"><Icon name="whatsapp" /> WhatsApp us</a>
    <a class="btn btn--ghost" href={`tel:${site.landline.tel}`}><Icon name="phone" /> {site.landline.display}</a>
  </Intro>

  <section class="section" style="padding-top: var(--space-m)">
    <div class="container contact-grid">
      <div>
        <h2 class="visually-hidden">Contact details</h2>
        <CardContact />
        <p class="small muted" style="margin-top: var(--space-l)">
          {site.address.lines.join(', ')}.{' '}
          <a href={site.address.mapsUrl} target="_blank" rel="noopener">Open in Google Maps</a>
        </p>
      </div>
      <div>
        <h2 style="font-size: var(--step-3)">Send an enquiry</h2>
        <p class="muted">Fill in what you know. We’ll turn it into a WhatsApp message for you to send.</p>
        <EnquiryComposer
          client:visible
          services={['General enquiry', 'Umrah', 'International tour', 'Airline tickets', 'Hotel booking', 'Visa assistance']}
          callTel={site.landline.tel}
          callDisplay={site.landline.display}
          email={site.email}
        />
      </div>
    </div>
  </section>

  <ExploreCards heading="Not sure yet? Start here" intro="Browse Umrah, destinations, visa help and current offers, then message us about anything." />
</BaseLayout>
