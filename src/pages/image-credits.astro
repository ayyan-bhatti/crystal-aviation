---
import BaseLayout from '../layouts/BaseLayout.astro';

const credits = [
  ["Masjid an-Nabawi courtyard at sunset, Madinah", "Haidan", "https://unsplash.com/photos/RhkbHU14MoA"],
  ["Green Dome and minarets, Masjid an-Nabawi", "Juned Khatri", "https://unsplash.com/photos/RJjHsurofj8"],
  ["Masjid al-Haram at night, Makkah", "Ben Latif", "https://unsplash.com/photos/VExggm_apD0"],
  ["Old city street with the Flame Towers, Baku", "Bao Menglong", "https://unsplash.com/photos/npwNgsQwmTU"],
  ["Wat Arun at sunset, Bangkok", "Haley Hong", "https://unsplash.com/photos/MKVGJ4d3E6c"],
  ["Supertree Grove and skyway, Singapore", "NIR HIMI", "https://unsplash.com/photos/ZHnzLl4oRCU"],
  ["Langkawi bay and islands, Malaysia", "belettenoir", "https://unsplash.com/photos/yAnklpY716k"],
];
---

<BaseLayout title="Photo credits" path="/image-credits" description="Credits for photography used on this website." noindex>
  <section class="section">
    <div class="container narrow">
      <h1 style="font-size: var(--step-4)">Photo credits</h1>
      <p>Photography from <a href="https://unsplash.com" rel="noopener">Unsplash</a>, used under the Unsplash License.</p>
      <ul>
        {credits.map(([what, who, url]) => <li>{what}, by <a href={url} rel="noopener">{who}</a></li>)}
      </ul>
    </div>
  </section>
</BaseLayout>
