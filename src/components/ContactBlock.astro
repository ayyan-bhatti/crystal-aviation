---
import Icon from './Icon';
import { site } from '../config/site';
import { serviceEnquiryMessage, whatsappLink } from '../lib/whatsapp';

interface Props {
  compact?: boolean;
}
const { compact = false } = Astro.props;
---

<div class="contact-people">
  {
    site.team.map((m) => (
      <div class="person">
        <h3>{m.name}</h3>
        <p class="person__role">{m.role}</p>
        <div class="btn-row">
          <a class="btn btn--whatsapp btn--small" href={whatsappLink(serviceEnquiryMessage('your travel services'), m.whatsapp)} target="_blank" rel="noopener" aria-label={`WhatsApp ${m.name} on ${m.display}`}>
            <Icon name="whatsapp" /> {m.display}
          </a>
          <a class="btn btn--ghost btn--small" href={`tel:${m.tel}`} aria-label={`Call ${m.name} on ${m.display}`}>
            <Icon name="phone" /> Call
          </a>
        </div>
      </div>
    ))
  }
  <div class="person">
    <ul class="contact-list">
      <li><Icon name="phone" /><span>Office landline: <a href={`tel:${site.landline.tel}`}>{site.landline.display}</a></span></li>
      <li><Icon name="mail" /><span><a href={`mailto:${site.email}`}>{site.email}</a></span></li>
      <li>
        <Icon name="pin" />
        <span>
          <address style="font-style: normal; display: inline">{site.address.lines.join(', ')}</address>
          {compact ? null : <br />}
          {' '}<a href={site.address.mapsUrl} target="_blank" rel="noopener">Open in Google Maps</a>
        </span>
      </li>
    </ul>
  </div>
</div>
