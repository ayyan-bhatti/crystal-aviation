---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  eyebrow: string;
  title: string;
  lead: string;
  image?: ImageMetadata;
  position?: string;
}
const { eyebrow, title, lead, image, position = 'center' } = Astro.props;
---

<section class:list={['page-hero', 'on-dark', { 'page-hero--plain': !image }]} aria-labelledby="page-title">
  {
    image ? (
      <div class="page-hero__media">
        <Image src={image} alt="" widths={[640, 1024, 1600]} sizes="100vw" loading="eager" style={`object-position: ${position}`} />
      </div>
    ) : null
  }
  <div class="container">
    <div class="page-hero__content">
      <p class="eyebrow">{eyebrow}</p>
      <h1 id="page-title">{title}</h1>
      <p class="lead">{lead}</p>
      <div class="btn-row"><slot /></div>
    </div>
  </div>
</section>
