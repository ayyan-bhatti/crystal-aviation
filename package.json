{
  "name": "crystal-aviation",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Website and promotions dashboard for The Crystal Aviation, Faisalabad.",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "astro preview",
    "check": "astro check",
    "test": "vitest run tests/unit tests/sql",
    "test:db": "node --env-file=.env.test ./node_modules/vitest/vitest.mjs run tests/db",
    "db:types": "node --env-file=.env.local scripts/db.mjs types",
    "staff:add": "node --env-file=.env.local scripts/provision-staff.mjs",
    "backup:posters": "node --env-file=.env.local scripts/backup-posters.mjs",
    "deploy": "astro build && wrangler deploy",
    "db:push": "node --env-file=.env.local scripts/db.mjs push",
    "db:local:start": "supabase start -x vector,logflare,realtime,edge-runtime,imgproxy,supavisor",
    "db:local:stop": "supabase stop",
    "db:local:reset": "supabase db reset",
    "test:unit": "vitest run tests/unit",
    "test:sql": "vitest run tests/sql"
  },
  "engines": {
    "node": ">=22.12.0"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.3",
    "@astrojs/react": "^7.0.0",
    "@fontsource-variable/bodoni-moda": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@supabase/supabase-js": "^2.117.2",
    "astro": "^7.3.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@electric-sql/pglite": "^0.5.8",
    "@types/node": "^24.19.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "supabase": "^2.118.0",
    "typescript": "^6.0.3",
    "vitest": "^5.0.2",
    "wrangler": "^4.141.0"
  }
}
